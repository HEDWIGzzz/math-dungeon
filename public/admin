<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Math Dungeon — Teacher Control</title><style>@import url('https://fonts.googleapis.com/css2?family=Kanit:wght@400;600;700&display=swap');*{box-sizing:border-box}body{margin:0;background:#070914;color:#fff;font-family:Kanit,sans-serif;padding:30px}.wrap{max-width:900px;margin:auto}.card{background:#11182b;border:1px solid #ffffff18;border-radius:20px;padding:22px;margin-top:16px}h1{margin:0}p{color:#94a0b8}.row{display:grid;grid-template-columns:70px 1fr 220px 100px;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid #ffffff0d}.row input{width:100%;padding:10px;border-radius:10px;border:1px solid #34405a;background:#080c18;color:#fff}.btn{padding:10px 14px;border:0;border-radius:10px;background:#6d5dfc;color:#fff;font-weight:700;cursor:pointer}.key{width:100%;padding:12px;border-radius:10px;border:1px solid #34405a;background:#080c18;color:#fff}.msg{margin-top:10px;color:#34d399}@media(max-width:700px){.row{grid-template-columns:45px 1fr}.row input,.row button{grid-column:1/-1}}</style></head><body><div class="wrap"><h1>🧙‍♂️ Math Dungeon — Teacher Control</h1><p>ตั้งรหัสผ่านของแต่ละฐานสำหรับนักเรียน รหัสจะถูกเก็บและตรวจสอบที่ Server</p><div class="card"><label>Admin Key</label><input id="key" class="key" placeholder="ใส่ ADMIN_KEY ของเซิร์ฟเวอร์"><button class="btn" style="margin-top:10px" onclick="load()">โหลดฐาน</button><div id="rows"></div><div id="msg" class="msg"></div></div></div><script>async function load(){const key=document.getElementById('key').value;const r=await fetch('/api/admin/stations?key='+encodeURIComponent(key));if(!r.ok)return msg('รหัส Admin ไม่ถูกต้อง');const data=await r.json();document.getElementById('rows').innerHTML=data.map(s=>`<div class="row"><b>#${s.id}</b><span>${s.name}</span><input id="c${s.id}" value="${esc(s.code)}"><button class="btn" onclick="save(${s.id})">บันทึก</button></div>`).join('');msg('โหลดสำเร็จ')}async function save(id){const key=document.getElementById('key').value;const code=document.getElementById('c'+id).value;const r=await fetch('/api/admin/stations?key='+encodeURIComponent(key),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,code})});msg(r.ok?'บันทึกรหัสฐาน #'+id+' แล้ว':'บันทึกไม่สำเร็จ')}function msg(x){document.getElementById('msg').textContent=x}function esc(s){return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</script></body></html>

