<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Math Dungeon Online</title>
<script src="/socket.io/socket.io.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700&display=swap');
:root{--bg:#070914;--panel:rgba(11,15,30,.86);--line:rgba(255,255,255,.12);--cyan:#65d9ff;--purple:#a78bfa;--gold:#f7c948;--green:#34d399;--red:#fb7185}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--bg);color:#fff;font-family:Kanit,sans-serif}body{user-select:none}button,input{font:inherit}button{cursor:pointer}
#game{position:fixed;inset:0;width:100%;height:100%;display:block;background:#080b17}
#vignette{position:fixed;inset:0;pointer-events:none;background:radial-gradient(circle at center,transparent 45%,rgba(0,0,0,.48) 100%)}
.hud{position:fixed;inset:0;pointer-events:none}.top{height:84px;display:flex;align-items:center;gap:12px;padding:12px 16px}.glass{background:var(--panel);border:1px solid var(--line);box-shadow:0 10px 40px rgba(0,0,0,.28);backdrop-filter:blur(12px)}
.player-card{height:60px;min-width:270px;border-radius:16px;padding:9px 14px;display:flex;gap:12px;align-items:center}.avatar-mini{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#5b4ae8,#25b6d9);display:grid;place-items:center;font-size:23px;box-shadow:0 0 20px #5b4ae855}.pname{font-weight:700}.sub{font-size:12px;color:#aab3ca}.xpbar{width:150px;height:6px;background:#20283e;border-radius:99px;overflow:hidden;margin-top:5px}.xpbar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--purple),var(--cyan));border-radius:99px}
.spacer{flex:1}.score{padding:10px 16px;border-radius:14px;font-weight:700;color:var(--gold);font-size:18px}.mini{width:190px;height:60px;border-radius:16px;overflow:hidden;position:relative}.mini canvas{width:100%;height:100%;display:block}.mini-label{position:absolute;left:9px;top:5px;font-size:11px;color:#c9d2e7;background:#070914aa;padding:1px 6px;border-radius:8px}
.left{position:fixed;left:16px;top:100px;width:285px;pointer-events:none}.quest{border-radius:18px;padding:15px;pointer-events:auto}.eyebrow{font-size:11px;color:var(--cyan);letter-spacing:1.2px;font-weight:700}.quest h2{margin:4px 0 2px;font-size:19px}.quest p{margin:0;color:#aeb7cc;font-size:13px}.progress{margin-top:13px;height:8px;background:#20283e;border-radius:99px;overflow:hidden}.progress i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--green),var(--cyan));transition:.5s}.stations{margin-top:12px;display:grid;gap:6px}.st{display:flex;align-items:center;gap:9px;padding:8px;border-radius:11px;background:#11182b88;border:1px solid transparent}.st.active{border-color:#65d9ff55;background:#18223c}.st.done{opacity:.9}.dot{width:24px;height:24px;border-radius:8px;display:grid;place-items:center;background:#202a40;font-size:12px}.st.done .dot{background:#1b7657;color:#fff}.st b{font-size:12px}.st small{display:block;color:#8490aa;font-size:10px}
.right{position:fixed;right:16px;top:100px;width:250px;pointer-events:none}.board{border-radius:18px;padding:13px;pointer-events:auto}.board h3{margin:0 0 8px;font-size:14px}.rank{display:flex;gap:8px;align-items:center;padding:7px 6px;border-radius:10px}.rank:nth-child(2){background:#ffffff06}.rankno{width:24px;color:#7e8aa5;font-size:12px}.rankname{flex:1;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rankscore{font-size:12px;color:var(--gold);font-weight:700}
.bottom{position:fixed;left:50%;bottom:14px;transform:translateX(-50%);width:min(780px,calc(100% - 32px));pointer-events:auto}.forge{border-radius:20px;padding:11px}.forge-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:7px}.forge-title{font-weight:700;font-size:14px}.forge-hint{font-size:11px;color:#8792aa}.eq{min-height:50px;border-radius:13px;background:#070b18;border:1px dashed #64708d;display:flex;align-items:center;justify-content:center;gap:6px;padding:7px;overflow-x:auto}.tile{min-width:38px;height:38px;border-radius:10px;display:grid;place-items:center;font-weight:700;font-size:18px;box-shadow:0 5px 12px #0005;transition:.12s}.tile:hover{transform:translateY(-2px)}.num{background:#f7c948;color:#111827}.op{background:#fb7185}.eqtile{background:#60a5fa}.inv{display:flex;gap:5px;justify-content:center;min-height:42px;padding-top:7px;flex-wrap:wrap}.actions{display:flex;gap:8px;justify-content:center;margin-top:7px}.btn{border:1px solid var(--line);border-radius:11px;padding:8px 18px;color:white;background:#141b2d;font-weight:700}.btn.primary{background:linear-gradient(135deg,#6d5dfc,#21a9d5);border:0}.btn:hover{filter:brightness(1.12)}
.toast{position:fixed;left:50%;top:95px;transform:translate(-50%,-20px) scale(.96);opacity:0;padding:12px 20px;border-radius:14px;background:#0d1426ee;border:1px solid #ffffff22;box-shadow:0 14px 50px #0008;transition:.25s;pointer-events:none;text-align:center;z-index:20}.toast.show{opacity:1;transform:translate(-50%,0) scale(1)}.toast b{display:block}.toast span{font-size:12px;color:#aeb7cc}
.modal{position:fixed;inset:0;background:#02040acc;display:none;align-items:center;justify-content:center;z-index:30;padding:20px}.modal.show{display:flex}.modalbox{width:min(440px,100%);border-radius:24px;padding:25px;background:linear-gradient(180deg,#121a30,#090e1e);border:1px solid #ffffff1c;box-shadow:0 30px 100px #000}.seal{width:70px;height:70px;border-radius:20px;margin:0 auto 10px;display:grid;place-items:center;font-size:32px;background:#65d9ff18;border:1px solid #65d9ff55;box-shadow:0 0 40px #65d9ff22}.modal h1{text-align:center;font-size:25px;margin:5px 0}.modal p{text-align:center;color:#98a4bd;font-size:13px}.code{width:100%;padding:14px;border-radius:13px;border:1px solid #33405c;background:#060a16;color:white;text-align:center;font-size:24px;letter-spacing:4px;outline:none;text-transform:uppercase}.modal-actions{display:flex;gap:8px;margin-top:10px}.modal-actions button{flex:1}.close{background:#171e31}.success{color:var(--green)!important}
#nameModal{display:flex}.name-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.name-grid label{font-size:11px;color:#8995ad}.name-grid input,.name-grid select{width:100%;margin-top:4px;padding:10px;border-radius:11px;border:1px solid #33405c;background:#070b18;color:white;outline:none}.full{grid-column:1/-1}.danger{color:#fb7185}.hintbox{margin-top:10px;background:#0a1020;border:1px solid #ffffff0c;border-radius:12px;padding:9px;font-size:11px;color:#8995ad}
#flash{position:fixed;inset:0;background:#fff;opacity:0;pointer-events:none;z-index:40}.levelup{position:fixed;left:50%;top:42%;transform:translate(-50%,-50%) scale(.7);opacity:0;z-index:41;text-align:center;pointer-events:none;transition:.35s}.levelup.show{opacity:1;transform:translate(-50%,-50%) scale(1)}.levelup strong{font-size:48px;color:var(--gold);text-shadow:0 0 30px #f7c948}.levelup div{font-size:18px}.help{position:fixed;left:16px;bottom:18px;font-size:11px;color:#76829b;background:#090f1d99;border:1px solid #ffffff0d;border-radius:10px;padding:7px 10px;pointer-events:none}
@media(max-width:1000px){.right{display:none}.left{width:245px}.mini{width:150px}.player-card{min-width:220px}.bottom{bottom:8px}.help{display:none}}
@media(max-width:720px){.top{padding:8px}.player-card{min-width:0;flex:1}.player-card .sub,.xpbar{display:none}.score{font-size:14px;padding:8px}.mini{display:none}.left{left:8px;top:82px;width:220px}.quest{padding:11px}.quest h2{font-size:16px}.bottom{width:calc(100% - 16px)}.tile{min-width:34px;height:34px}.btn{padding:7px 11px}}
</style>
</head>
<body>
<canvas id="game"></canvas><canvas id="mini" class="mini"></canvas><div id="vignette"></div>
<div class="hud">
  <div class="top">
    <div class="player-card glass"><div id="avatarMini" class="avatar-mini">🧙</div><div style="min-width:0"><div class="pname" id="playerName">กำลังเชื่อมต่อ...</div><div class="sub">LEVEL <b id="level">1</b> · <span id="completed">0/5</span> ฐาน</div><div class="xpbar"><i id="xpFill"></i></div></div></div>
    <div class="spacer"></div><div class="score glass">🏆 <span id="score">0</span></div><div class="mini glass"><canvas id="miniCanvas"></canvas><span class="mini-label">MINI MAP</span></div>
  </div>
  <div class="left"><div class="quest glass"><div class="eyebrow">MAIN QUEST</div><h2 id="questTitle">เดินทางสู่ประตูแห่งสมการ</h2><p id="questDesc">ค้นหาแท่นภารกิจและปลดล็อกด้วยรหัสจากใบงาน</p><div class="progress"><i id="questProgress"></i></div><div class="stations" id="stations"></div></div></div>
  <div class="right"><div class="board glass"><h3>🏆 HALL OF HEROES</h3><div id="leaderboard"></div></div></div>
  <div class="bottom"><div class="forge glass"><div class="forge-head"><div class="forge-title">✨ SPELL FORGE <span class="sub">ประกอบสมการให้ถูกต้อง</span></div><div class="forge-hint">คลิกชิ้นส่วนเพื่อย้าย</div></div><div class="eq" id="eq"></div><div class="inv" id="inv"></div><div class="actions"><button class="btn" onclick="clearEquation()">↩ ล้าง</button><button class="btn primary" onclick="castSpell()">✨ ร่ายคาถา</button></div></div></div>
</div>
<div class="help">WASD / Arrow Keys = เคลื่อนที่ · เดินชนแท่นเพื่อปลดล็อก · รหัสมาจากใบงานของครู</div>
<div id="toast" class="toast"><b id="toastTitle"></b><span id="toastText"></span></div>
<div id="stationModal" class="modal"><div class="modalbox"><div class="seal">🔐</div><h1 id="stationName">สถานี</h1><p>กรอกรหัสที่ได้จากใบงานของครูเพื่อปลดผนึกพื้นที่</p><input id="codeInput" class="code" maxlength="40" autocomplete="off" placeholder="ACCESS CODE"><div class="modal-actions"><button class="btn close" onclick="closeStation()">ยกเลิก</button><button class="btn primary" onclick="submitCode()">🔓 ปลดผนึก</button></div><div class="hintbox">💡 รหัสถูกตรวจสอบบนเซิร์ฟเวอร์ นักเรียนไม่สามารถดูรหัสจากหน้าเว็บได้</div></div></div>
<div id="nameModal" class="modal"><div class="modalbox"><div class="seal">🏰</div><h1>เข้าสู่ Math Dungeon</h1><p>ห้องเรียนคณิตศาสตร์ในรูปแบบ Multiplayer RPG</p><div class="name-grid"><div class="full"><label>ชื่อผู้เล่น</label><input id="nameInput" maxlength="18" placeholder="เช่น โด้"></div><div><label>ตัวละคร</label><select id="avatarInput"><option value="hero">⚔️ Guardian</option><option value="wizard">🧙 Mage</option><option value="robot">🤖 Arcane Bot</option></select></div><div><label>หมวก</label><select id="hatInput"><option value="none">ไม่มี</option><option value="wizard_hat">หมวกเวท</option><option value="cap">หมวกเกราะ</option></select></div><div class="full"><label>สีเสื้อคลุม</label><input id="colorInput" type="color" value="#6d5dfc"></div></div><button class="btn primary" style="width:100%;margin-top:12px;padding:12px" onclick="joinGame()">⚔️ เข้าสู่ดันเจี้ยน</button><div class="hintbox">ครูสามารถตั้งรหัสฐาน 1–5 ได้ที่ <b>/admin</b></div></div></div>
<div id="flash"></div><div id="levelup" class="levelup"><strong>LEVEL UP!</strong><div>พลังเวทของคุณเพิ่มขึ้น</div></div>
<script>
const socket=io(); const canvas=document.getElementById('game'),ctx=canvas.getContext('2d'); const mini=document.getElementById('miniCanvas'),mctx=mini.getContext('2d');
let W=innerWidth,H=innerHeight,dpr=devicePixelRatio||1; let world={width:4000,height:4000}; let stations=[],tiles=[],players={}; let me=null,myId=null,started=false,currentStation=null; let inventory=[],equation=[]; const keys={w:false,a:false,s:false,d:false};
const particles=[]; const camera={x:0,y:0};
function resize(){W=innerWidth;H=innerHeight;canvas.width=W*dpr;canvas.height=H*dpr;canvas.style.width=W+'px';canvas.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);mini.width=180*dpr;mini.height=60*dpr;mctx.setTransform(dpr,0,0,dpr,0,0)} addEventListener('resize',resize);resize();
function joinGame(){socket.emit('setupPlayer',{name:document.getElementById('nameInput').value,avatar:document.getElementById('avatarInput').value,hat:document.getElementById('hatInput').value,outfitColor:document.getElementById('colorInput').value});document.getElementById('nameModal').classList.remove('show');started=true}
function setKey(k,v){k=k.toLowerCase();if(k==='w'||k==='arrowup')keys.w=v;if(k==='s'||k==='arrowdown')keys.s=v;if(k==='a'||k==='arrowleft')keys.a=v;if(k==='d'||k==='arrowright')keys.d=v}
addEventListener('keydown',e=>{if(started){setKey(e.key,true);if(e.key==='Enter'&&document.getElementById('stationModal').classList.contains('show'))submitCode()}});addEventListener('keyup',e=>setKey(e.key,false));
['btnUp','btnDown','btnLeft','btnRight'].forEach(()=>{});
socket.on('initGame',d=>{myId=d.id;world=d.world;stations=d.stations;tiles=d.tiles;renderStations()});
socket.on('playerReady',d=>{me=d.player;updateUI();showToast('ยินดีต้อนรับ '+me.name,'ค้นหาแท่นภารกิจแรกแล้วเริ่มการผจญภัย','cyan')});
socket.on('stateUpdate',p=>{players=p; if(players[myId]){const old=me;me=players[myId];if(old&&me.level>old.level)levelUp();updateUI();}});
socket.on('leaderboard',list=>{document.getElementById('leaderboard').innerHTML=list.map(p=>`<div class="rank"><span class="rankno">${p.rank===1?'👑':String(p.rank).padStart(2,'0')}</span><span class="rankname">${esc(p.name)}</span><span class="rankscore">${p.score.toLocaleString()}</span></div>`).join('')||'<div class="sub">รอผู้เล่น...</div>'});
socket.on('tileCollected',t=>{inventory.push(t);renderForge();burst(t.x,t.y,'#f7c948',8);showToast('Rune Acquired','เก็บชิ้นส่วนสมการแล้ว','gold')});socket.on('tileRemoved',id=>tiles=tiles.filter(t=>t.id!==id));socket.on('newTile',t=>tiles.push(t));
socket.on('stationPrompt',d=>{currentStation=d.stationId;document.getElementById('stationName').textContent='🔐 '+d.name;document.getElementById('codeInput').value='';document.getElementById('stationModal').classList.add('show');setTimeout(()=>document.getElementById('codeInput').focus(),50)});
socket.on('stationResult',r=>{if(r.success){document.getElementById('stationModal').classList.remove('show');if(r.already){showToast('ปลดล็อกแล้ว','พื้นที่นี้ผ่านภารกิจเรียบร้อย','green')}else{burst(me.x,me.y,'#65d9ff',50);flash();showToast('ACCESS GRANTED','+'+r.reward+' SCORE · +'+(r.reward*2)+' XP','green')}renderStations()}else showToast('ACCESS DENIED',r.msg,'red')});
socket.on('equationResult',r=>{if(r.success){equation=[];renderForge();showToast('SPELL PERFECT','+40 SCORE · +50 XP','green');burst(me.x,me.y,'#a78bfa',28)}else showToast('SPELL FAILED',r.msg,'red')});
socket.on('stationWorldUpdate',d=>burst(stations.find(s=>s.id===d.stationId)?.x||2000,stations.find(s=>s.id===d.stationId)?.y||2000,'#34d399',35));
socket.on('serverFull',d=>showToast('SERVER FULL','ห้องเรียนเต็มแล้ว ('+d.max+' คน)','red'));
function submitCode(){if(!currentStation)return;socket.emit('submitStationCode',{stationId:currentStation,code:document.getElementById('codeInput').value})}function closeStation(){document.getElementById('stationModal').classList.remove('show')}
function renderStations(){const done=me?.completed||0;document.getElementById('stations').innerHTML=stations.map((s,i)=>{const isDone=me?.completed>=s.id;const active=!isDone&&s.id===done+1;return `<div class="st ${isDone?'done':''} ${active?'active':''}"><div class="dot">${isDone?'✓':s.id}</div><div><b>${esc(s.name)}</b><small>${isDone?'ปลดล็อกแล้ว':active?'ภารกิจถัดไป':'ล็อกอยู่'}</small></div></div>`}).join('')}
function updateUI(){if(!me)return;document.getElementById('playerName').textContent=me.name;document.getElementById('level').textContent=me.level;document.getElementById('score').textContent=me.score.toLocaleString();document.getElementById('completed').textContent=me.completed+'/5';document.getElementById('questProgress').style.width=(me.completed/5*100)+'%';const xp=(me.xp%500)/5;document.getElementById('xpFill').style.width=xp+'%';document.getElementById('avatarMini').textContent=me.avatar==='wizard'?'🧙':me.avatar==='robot'?'🤖':'⚔️';const next=stations.find(s=>s.id===me.completed+1);document.getElementById('questTitle').textContent=next?next.name:'🏆 FINAL VICTORY';document.getElementById('questDesc').textContent=next?'เดินทางไปยังแท่นและใช้รหัสจากใบงาน':'คุณพิชิตทุกฐานแล้ว! คุณคือจอมเวทย์คณิตศาสตร์'}renderStations()}
function renderForge(){const box=document.getElementById('eq'),inv=document.getElementById('inv');box.innerHTML=equation.map((t,i)=>tileEl(t,()=>{inventory.push(equation.splice(i,1)[0]);renderForge()})).join('');inv.innerHTML=inventory.map((t,i)=>tileEl(t,()=>{equation.push(inventory.splice(i,1)[0]);renderForge()})).join('')||'<span class="sub">เก็บ Rune รอบแผนที่เพื่อเริ่มสร้างสมการ</span>'}
function tileEl(t,fn){return `<button class="tile ${t.type==='num'?'num':t.type==='op'?'op':'eqtile'}" data-id="${t.id}">${esc(t.char)}</button>`}
document.addEventListener('click',e=>{const b=e.target.closest('.tile');if(!b)return;const id=Number(b.dataset.id);const t=inventory.find(x=>x.id===id);if(t){inventory=inventory.filter(x=>x.id!==id);equation.push(t);renderForge();return}const q=equation.find(x=>x.id===id);if(q){equation=equation.filter(x=>x.id!==id);inventory.push(q);renderForge()}});
function clearEquation(){inventory=inventory.concat(equation);equation=[];renderForge()}function castSpell(){if(!equation.length)return showToast('SPELL FORGE','ยังไม่มีสมการให้ร่าย','red');socket.emit('submitEquation',equation.map(t=>t.char).join(''))}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function showToast(title,text,type){const t=document.getElementById('toast');document.getElementById('toastTitle').textContent=title;document.getElementById('toastText').textContent=text;t.style.borderColor=type==='red'?'#fb718566':type==='green'?'#34d39966':type==='gold'?'#f7c94866':'#65d9ff66';t.classList.add('show');clearTimeout(showToast.tm);showToast.tm=setTimeout(()=>t.classList.remove('show'),2600)}
function flash(){const f=document.getElementById('flash');f.animate([{opacity:.65},{opacity:0}],{duration:500})}function levelUp(){const l=document.getElementById('levelup');l.classList.add('show');flash();setTimeout(()=>l.classList.remove('show'),1800)}
function burst(x,y,c,n){for(let i=0;i<n;i++){const a=Math.random()*Math.PI*2,s=1+Math.random()*5;particles.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:1,c,size:2+Math.random()*3})}}
function drawWorld(){ctx.fillStyle='#080b17';ctx.fillRect(0,0,W,H);camera.x=me?me.x-W/2:1800;camera.y=me?me.y-H/2:2200;camera.x=Math.max(0,Math.min(world.width-W,camera.x));camera.y=Math.max(0,Math.min(world.height-H,camera.y));ctx.save();ctx.translate(-camera.x,-camera.y);
  // floor
  const g=ctx.createLinearGradient(0,0,world.width,world.height);g.addColorStop(0,'#0c1222');g.addColorStop(.5,'#11162a');g.addColorStop(1,'#080d1a');ctx.fillStyle=g;ctx.fillRect(0,0,world.width,world.height);
  // grid
  ctx.strokeStyle='#ffffff08';ctx.lineWidth=1;for(let x=0;x<=world.width;x+=100){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,world.height);ctx.stroke()}for(let y=0;y<=world.height;y+=100){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(world.width,y);ctx.stroke()}
  // roads
  ctx.fillStyle='#161d32';ctx.fillRect(0,1920,4000,160);ctx.fillRect(1920,0,160,4000);ctx.strokeStyle='#2b3550';ctx.lineWidth=3;for(let x=40;x<4000;x+=90){ctx.beginPath();ctx.moveTo(x,2000);ctx.lineTo(x+45,2000);ctx.stroke()}for(let y=40;y<4000;y+=90){ctx.beginPath();ctx.moveTo(2000,y);ctx.lineTo(2000,y+45);ctx.stroke()}
  // castle core
  drawCastle(2000,2000);
  stations.forEach(s=>drawStation(s));
  // tiles
  tiles.forEach(t=>{ctx.save();ctx.translate(t.x,t.y);const pulse=1+Math.sin(Date.now()/180+t.id)*.12;ctx.shadowBlur=18;ctx.shadowColor=t.type==='num'?'#f7c948':t.type==='op'?'#fb7185':'#60a5fa';ctx.fillStyle=t.type==='num'?'#f7c948':t.type==='op'?'#fb7185':'#60a5fa';ctx.beginPath();ctx.arc(0,0,14*pulse,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;ctx.fillStyle='#111827';ctx.font='bold 15px Kanit';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(t.char,0,1);ctx.restore()});
  // players
  const arr=Object.values(players).sort((a,b)=>a.y-b.y);arr.forEach(p=>drawPlayer(p,p.id===myId));
  particles.forEach(q=>{ctx.globalAlpha=Math.max(0,q.life);ctx.fillStyle=q.c;ctx.beginPath();ctx.arc(q.x,q.y,q.size,0,Math.PI*2);ctx.fill()});ctx.globalAlpha=1;ctx.restore();
}
function drawCastle(x,y){ctx.save();ctx.translate(x,y);ctx.shadowBlur=45;ctx.shadowColor='#7655ff44';ctx.fillStyle='#151c34';ctx.strokeStyle='#7b6cf666';ctx.lineWidth=7;ctx.fillRect(-330,-330,660,660);ctx.strokeRect(-330,-330,660,660);ctx.shadowBlur=0;ctx.fillStyle='#0b1020';ctx.fillRect(-220,-220,440,440);ctx.strokeStyle='#65d9ff22';ctx.lineWidth=3;ctx.beginPath();ctx.arc(0,0,250,0,Math.PI*2);ctx.stroke();ctx.beginPath();ctx.arc(0,0,150,0,Math.PI*2);ctx.stroke();for(const [dx,dy] of [[-360,-360],[260,-360],[-360,260],[260,260]]){ctx.fillStyle='#222c49';ctx.fillRect(dx,dy,100,100);ctx.strokeStyle='#65739b';ctx.strokeRect(dx,dy,100,100)}ctx.fillStyle='#65d9ff22';ctx.fillRect(-70,250,140,80);ctx.strokeStyle='#65d9ff';ctx.strokeRect(-70,250,140,80);ctx.fillStyle='#fff';ctx.font='bold 16px Kanit';ctx.textAlign='center';ctx.fillText('MATH DUNGEON',0,-5);ctx.restore()}
function drawStation(s){const done=me?.completed>=s.id;const pulse=1+Math.sin(Date.now()/250+s.id)*.08;ctx.save();ctx.translate(s.x,s.y);ctx.shadowBlur=done?20:35;ctx.shadowColor=s.color;ctx.strokeStyle=s.color;ctx.lineWidth=done?3:5;ctx.globalAlpha=done?.75:1;ctx.beginPath();ctx.arc(0,0,58*pulse,0,Math.PI*2);ctx.stroke();ctx.beginPath();ctx.arc(0,0,38,0,Math.PI*2);ctx.stroke();ctx.fillStyle='#0b1020ee';ctx.beginPath();ctx.arc(0,0,29,0,Math.PI*2);ctx.fill();ctx.fillStyle=s.color;ctx.font='bold 22px Kanit';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(done?'✓':s.id,0,1);ctx.shadowBlur=0;ctx.fillStyle='#fff';ctx.font='bold 13px Kanit';ctx.fillText(s.name,0,-78);ctx.font='11px Kanit';ctx.fillStyle='#8f9bb3';ctx.fillText(done?'UNLOCKED':'LOCKED',0,-61);if(!done&&me&&Math.hypot(me.x-s.x,me.y-s.y)<150){ctx.fillStyle='#ffffff';ctx.font='bold 11px Kanit';ctx.fillText('PRESS ENTER / ENTER CODE',0,83)}ctx.restore()}
function drawPlayer(p,isMe){ctx.save();ctx.translate(p.x,p.y);const bob=p.isMoving?Math.sin(Date.now()/90)*3:0;ctx.translate(0,bob);if(isMe){ctx.shadowBlur=25;ctx.shadowColor='#65d9ff88';ctx.strokeStyle='#65d9ff';ctx.lineWidth=2;ctx.beginPath();ctx.arc(0,0,29,0,Math.PI*2);ctx.stroke()}ctx.shadowBlur=0;ctx.fillStyle=p.outfitColor||'#6d5dfc';ctx.beginPath();ctx.roundRect(-15,-5,30,29,8);ctx.fill();ctx.fillStyle='#f4c7a1';ctx.beginPath();ctx.arc(0,-20,14,0,Math.PI*2);ctx.fill();ctx.fillStyle='#1c2942';ctx.fillRect(-9,20,6,9);ctx.fillRect(3,20,6,9);if(p.hat==='wizard_hat'){ctx.fillStyle='#8b5cf6';ctx.beginPath();ctx.moveTo(-17,-28);ctx.lineTo(17,-28);ctx.lineTo(0,-52);ctx.closePath();ctx.fill()}else if(p.hat==='cap'){ctx.fillStyle='#334155';ctx.beginPath();ctx.arc(0,-25,13,Math.PI,0);ctx.fill()}ctx.fillStyle='#fff';ctx.font='bold 12px Kanit';ctx.textAlign='center';ctx.fillText(p.name,0,-59);ctx.font='10px Kanit';ctx.fillStyle=isMe?'#65d9ff':'#9aa6bd';ctx.fillText('LV '+p.level,0,-45);if(p.score>0){const top=[...Object.values(players)].sort((a,b)=>b.score-a.score)[0];if(top&&top.id===p.id){ctx.fillStyle='#f7c948';ctx.font='18px sans-serif';ctx.fillText('👑',0,-68)}}ctx.restore()}
function update(){if(started&&me){let dx=(keys.d?1:0)-(keys.a?1:0),dy=(keys.s?1:0)-(keys.w?1:0);if(dx||dy){const l=Math.hypot(dx,dy);dx/=l;dy/=l;socket.emit('move',{x:me.x+dx*7,y:me.y+dy*7,isMoving:true})}else socket.emit('move',{x:me.x,y:me.y,isMoving:false});const next=stations.find(s=>s.id===me.completed+1);if(next&&Math.hypot(me.x-next.x,me.y-next.y)<90&&next.id===me.completed+1){/* prompt only on explicit proximity enter */}}
  for(let i=particles.length-1;i>=0;i--){const q=particles[i];q.x+=q.vx;q.y+=q.vy;q.vx*=.96;q.vy*=.96;q.life-=.025;if(q.life<=0)particles.splice(i,1)}drawWorld();drawMini();requestAnimationFrame(update)}
function drawMini(){const w=180,h=60;mctx.clearRect(0,0,w,h);mctx.fillStyle='#080c18';mctx.fillRect(0,0,w,h);mctx.strokeStyle='#ffffff12';mctx.strokeRect(2,2,w-4,h-4);stations.forEach(s=>{mctx.fillStyle=me?.completed>=s.id?'#34d399':s.color;mctx.beginPath();mctx.arc(s.x/world.width*w,s.y/world.height*h,3,0,Math.PI*2);mctx.fill()});Object.values(players).forEach(p=>{mctx.fillStyle=p.id===myId?'#fff':'#64748b';mctx.fillRect(p.x/world.width*w-1,p.y/world.height*h-1,2,2)})}
setInterval(()=>{const next=stations.find(s=>s.id===(me?.completed||0)+1);if(next&&me&&Math.hypot(me.x-next.x,me.y-next.y)<120&&!document.getElementById('stationModal').classList.contains('show')){socket.emit('requestStationUnlock',{stationId:next.id})}},700);
renderForge();document.getElementById('nameModal').classList.add('show');update();
</script></body></html>

